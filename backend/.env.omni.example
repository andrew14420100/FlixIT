# Local Node/Stremio runtime used only when explicitly enabled.
OMNI_ENABLED=true
OMNI_ADDON_URL=http://127.0.0.1:7001
OMNI_RUNTIME_DIR=/app/omni-runtime
OMNI_START_TIMEOUT=20

# Optional end-to-end player quality test using a public Mux HLS sample.
# Keep disabled outside testing. When enabled, only the configured IMDb id
# returns the public test stream; all other ids still return streams: [].
OMNI_4K_TEST_MODE=false
OMNI_4K_TEST_ID=tt15239678
# OMNI_4K_TEST_URL=https://test-streams.mux.dev/test_001/stream.m3u8
